#----------------------------------------------------------------------------
#       Macros
#----------------------------------------------------------------------------
CC            = gcc
CXX           = g++
CPPFLAGS      = $(PICFLAGS) $(GENFLAGS) -fpermissive -g $(SAL_CPPFLAGS) -D_REENTRANT -Wall -Wno-switch -Wno-format -I"." -I"$(LSST_SAL_PREFIX)/include" -I"$(CONDA_PREFIX)/include" -I"$(LSST_SAL_PREFIX)/include/boost" -I"$(CONDA_PREFIX)/include/boost" -I"$(LSST_SAL_PREFIX)/include/avro" -I"$(CONDA_PREFIX)/include/avro" -I../../../SALSubsys/cpp/src -I../../../SALSubsys/cpp -I"$(SAL_WORK_DIR)/include" -Wno-write-strings #-DSAL_SUBSYSTEM_ID_IS_KEYED
LD            = $(CXX) $(CCFLAGS) $(CPPFLAGS)
AR            = ar
PICFLAGS      = -fPIC
OBJEXT        = .o
SHLIBEXT      = .so
OUTPUT_OPTION = -o "$@"
COMPILE.c     = $(CC) $(CFLAGS) $(CPPFLAGS) -c
COMPILE.cc    = $(CXX) $(CCFLAGS) $(CPPFLAGS) -c
LDFLAGS       = -fPIC -L"." -L"$(LSST_SAL_PREFIX)/lib" -L"$(CONDA_PREFIX)/lib" -Wl,-rpath,\$$ORIGIN -L"$(SAL_WORK_DIR)/lib"
CCC           = $(CXX)
MAKEFILE      = Makefile.sacpp_TestWithSalobj
DEPENDENCIES  = 
BTARGETDIR    = ./
CAT           = cat
MV            = mv -f
RM            = rm -rf
CP            = cp -p
NUL           = /dev/null
MKDIR         = mkdir -p
TESTDIRSTART  = test -d
TESTDIREND    = ||
TOUCH         = touch
EXEEXT        = 
LIBPREFIX     = lib
LIBSUFFIX     = 
GENFLAGS      = -g
# libschemaregistry replaces libserdes. Because libschemaregistry is a static
# archive, its vcpkg-built transitive deps (abseil, cpr, curl, ssl, boost,
# compression) must be linked explicitly. These archives reference each
# other's symbols, so their order on the link line matters to the linker;
# --start-group/--end-group makes the linker re-scan them until all those
# cross-references resolve, so the order among them no longer matters.
# LIBSCHEMAREGISTRY_VCPKG_LIB defaults to the SAL prefix; until the build
# helper copies the vcpkg deps there, override it to the vcpkg_installed lib
# dir.
LIBSCHEMAREGISTRY_VCPKG_LIB ?= $(LSST_SAL_PREFIX)/lib
LIBSCHEMAREGISTRY_LDLIBS = -Wl,--start-group $(LSST_SAL_PREFIX)/lib/libschemaregistry.a $(wildcard $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libabsl_*.a) $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libcpr.a $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libcurl.a $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libz.a $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libbz2.a $(LIBSCHEMAREGISTRY_VCPKG_LIB)/liblzma.a $(LIBSCHEMAREGISTRY_VCPKG_LIB)/libzstd.a -Wl,--end-group
LDLIBS        = -ldl -lrt -lpthread -lboost_filesystem -lboost_iostreams -lboost_program_options -lboost_regex -lboost_system -lsnappy $(LIBSCHEMAREGISTRY_LDLIBS) -lrdkafka++ -lrdkafka -lavrocpp -lsasl2 -lssl -lcrypto -llz4
OBJS          =  .obj/sacpp_TestWithSalobj$(OBJEXT) .obj/SAL_Test$(OBJEXT)
SRC           =  ../src/sacpp_TestWithSalobj.cpp ../src/SAL_Test.cpp
OBJS2         =  .obj/sacpp_TestWithSalobjTarget$(OBJEXT) .obj/SAL_Test$(OBJEXT)
SRC2          =  ../src/sacpp_TestWithSalobjTarget.cpp ../src/SAL_Test.cpp
LINK.cc       = $(LD) $(LDFLAGS)
EXPORTFLAGS   = 

#----------------------------------------------------------------------------
#       Local targets
#----------------------------------------------------------------------------

all: sacpp_TestWithSalobj sacpp_TestWithSalobjTarget

sacpp_TestWithSalobj: $(OBJS)
	@$(TESTDIRSTART) "$(BTARGETDIR)" $(TESTDIREND) $(MKDIR) "$(BTARGETDIR)"
	$(LINK.cc) $(OBJS) $(LDLIBS) $(OUTPUT_OPTION)

sacpp_TestWithSalobjTarget: $(OBJS2)
	@$(TESTDIRSTART) "$(BTARGETDIR)" $(TESTDIREND) $(MKDIR) "$(BTARGETDIR)"
	$(LINK.cc) $(OBJS2) $(LDLIBS) $(OUTPUT_OPTION)

generated: $(GENERATED_DIRTY)
	@-:


.obj/SAL_Test$(OBJEXT): ../src/SAL_Test.cpp
	@$(TESTDIRSTART) ".obj/../src" $(TESTDIREND) $(MKDIR) ".obj/../src"
	$(COMPILE.cc) $(EXPORTFLAGS) $(OUTPUT_OPTION) ../src/SAL_Test.cpp

.obj/sacpp_TestWithSalobj$(OBJEXT): ../src/sacpp_TestWithSalobj.cpp
	@$(TESTDIRSTART) ".obj/../src" $(TESTDIREND) $(MKDIR) ".obj/../src"
	$(COMPILE.cc) $(EXPORTFLAGS) $(OUTPUT_OPTION) ../src/sacpp_TestWithSalobj.cpp

.obj/sacpp_TestWithSalobjTarget$(OBJEXT): ../src/sacpp_TestWithSalobjTarget.cpp
	@$(TESTDIRSTART) ".obj/../src" $(TESTDIREND) $(MKDIR) ".obj/../src"
	$(COMPILE.cc) $(EXPORTFLAGS) $(OUTPUT_OPTION) ../src/sacpp_TestWithSalobjTarget.cpp

clean:
	-$(RM) $(OBJS) $(OBJS2)

realclean: clean
	-$(RM) sacpp_TestWithSalobj sacpp_TestWithSalobjTarget
	-$(RM) .obj/

check-syntax:
	$(COMPILE.cc) $(EXPORTFLAGS) -Wall -Wextra -pedantic -fsyntax-only $(CHK_SOURCES)

#----------------------------------------------------------------------------
#       Dependencies
#----------------------------------------------------------------------------

$(DEPENDENCIES):
	@$(TOUCH) $(DEPENDENCIES)

depend:
	-VDIR=.obj/ $(MPC_ROOT)/depgen.pl  $(CFLAGS) $(CCFLAGS) $(CPPFLAGS) -f $(DEPENDENCIES) $(SRC) 2> $(NUL)

include $(DEPENDENCIES)
